{
  "name": "ai-crypto-flash-arbitrage-system",
  "version": "1.0.0",
  "description": "AI-powered crypto flash arbitrage system with smart contracts",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:arbitrum": "hardhat run scripts/deploy.js --network arbitrum",
    "deploy:optimism": "hardhat run scripts/deploy.js --network optimism",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "verify:polygon": "hardhat verify --network polygon",
    "verify:arbitrum": "hardhat verify --network arbitrum",
    "verify:optimism": "hardhat verify --network optimism",
    "test:contract": "hardhat run scripts/test-contract.js",
    "gas-report": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage"
  },
  "keywords": [
    "ethereum",
    "arbitrage",
    "defi",
    "flash-loans",
    "uniswap",
    "aave",
    "smart-contracts"
