# =============================================================================
# HFT Arbitrage Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
RUST_LOG=info
RUST_BACKTRACE=1
LOG_LEVEL=info
ENABLE_TRACING=true

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql://hftbot:secure_password_change_me@localhost:5432/hft_bot
POSTGRES_DB=hft_bot
POSTGRES_USER=hftbot
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# =============================================================================
# Monitoring & Metrics
# =============================================================================
METRICS_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_me

# =============================================================================
# Performance Configuration
# =============================================================================
MAX_CONCURRENT_ORDERS=100
ORDER_TIMEOUT_MS=5000
LATENCY_TARGET_US=1000

# =============================================================================
# WebSocket Configuration
# =============================================================================
WEBSOCKET_RECONNECT_INTERVAL_MS=1000
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10

# =============================================================================
# Exchange API Configuration
# =============================================================================
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_API_URL=https://api.binance.com/api/v3
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
BINANCE_RATE_LIMIT=1200

# OKX
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_API_URL=https://www.okx.com/api/v5
OKX_WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_RATE_LIMIT=20

# Other Exchanges
KRAKEN_API_URL=https://api.kraken.com/0/public
COINBASE_API_URL=https://api.exchange.coinbase.com

# =============================================================================
# EVM/Blockchain Configuration
# =============================================================================
# RPC Configuration (Use your own RPC endpoint for production)
EVM_RPC_URL=https://eth.llamarpc.com
# Or use Alchemy: https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Or use Infura: https://mainnet.infura.io/v3/YOUR_API_KEY

# Chain ID (1 = Ethereum Mainnet, 5 = Goerli, 11155111 = Sepolia)
EVM_CHAIN_ID=1

# Wallet Private Key (WITHOUT 0x prefix)
# IMPORTANT: Keep this secret! Use environment variables or secrets manager in production
EVM_PRIVATE_KEY=your_ethereum_wallet_private_key_without_0x_prefix

# =============================================================================
# Smart Contract Addresses
# =============================================================================
# Flash Arbitrage Contract (Deploy using contracts/FlashArbSecure.sol)
FLASH_ARB_ADDRESS=0x0000000000000000000000000000000000000000

# DeFi Protocol Addresses (Ethereum Mainnet)
AAVE_POOL_ADDRESS=0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
UNISWAP_V3_QUOTER=0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_USDC_WETH_POOL=0x88e6A0c2dDD26FEEb64F039a2c41296FcB3f5640
SUSHISWAP_ROUTER=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F

# Token Addresses (Ethereum Mainnet)
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
DAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F
WBTC_ADDRESS=0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599

# Multi-Chain Token Addresses
WETH_POLYGON_ADDRESS=0x7ceB23fD6bC0adD59E62ac25578270cFf1b9f619
WETH_ARBITRUM_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
WETH_OPTIMISM_ADDRESS=0x4200000000000000000000000000000000000006
USDC_POLYGON_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
USDC_ARBITRUM_ADDRESS=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
USDC_OPTIMISM_ADDRESS=0x7F5c764cBc14f9669B88837ca1490cCa17c31607

# Chainlink Oracle Addresses
WETH_CHAINLINK_ORACLE=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
WBTC_CHAINLINK_ORACLE=0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599
USDC_CHAINLINK_ORACLE=0x8fFfFfd4AfB6115b954Bd326cbe7B4BA576818f6

# Test Addresses
TEST_ADDRESS=0x0000000000000000000000000000000000000001

# Native Token Addresses
ETH_NATIVE_ADDRESS=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee

# Cross-Chain Trading Configuration
MIN_PROFIT_THRESHOLD=0.02
MAX_RISK_SCORE=0.7
MAX_DAILY_VOLUME=100000
BRIDGE_FAILURE_TOLERANCE=0.1

# Bridge Fees (as decimals)
BRIDGE_FEE_POLYGON=0.005
BRIDGE_FEE_ARBITRUM=0.003
BRIDGE_FEE_OPTIMISM=0.002

# Bridge Transfer Limits
MIN_TRANSFER_POLYGON=100
MAX_TRANSFER_POLYGON=100000
MIN_TRANSFER_ARBITRUM=50
MAX_TRANSFER_ARBITRUM=50000
MIN_TRANSFER_OPTIMISM=200
MAX_TRANSFER_OPTIMISM=200000

# MEV Configuration
DEFAULT_GAS_LIMIT=1000000
MEV_FEE_RATE=9
MIN_AMOUNT_OUT=1000000
ESTIMATED_GAS_USAGE=500000

# =============================================================================
# Risk Management Configuration
# =============================================================================
MAX_POSITION_SIZE=1000000
MAX_DAILY_LOSS=100000
MEV_TIMEOUT_SECONDS=30

# =============================================================================
# External API Configuration
# =============================================================================
# Price Data APIs
1INCH_API_URL=https://api.1inch.io/v5.0
0X_API_URL=https://api.0x.org/swap/v1
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Gas Price APIs
ETH_GAS_STATION_URL=https://api.ethgasstation.info/api/ethgasAPI.json
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=YourApiKey

# RPC URLs for different chains
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your-api-key
BSC_RPC_URL=https://bsc-dataseed.binance.org/
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# =============================================================================
# MEV (Maximal Extractable Value) Configuration
# =============================================================================
# Enable MEV-first execution (true/false)
USE_MEV_FIRST=true

# Allow fallback to public mempool if MEV fails (true/false)
# WARNING: Set to false for sensitive transactions to avoid frontrunning
ALLOW_PUBLIC_MEMPOOL=false

# Flashbots Relay
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
# Generate signing key: openssl rand -hex 32
FLASHBOTS_SIGNING_KEY=your_flashbots_signing_key_hex

# MEV-Share (Optional - for MEV sharing strategies)
MEV_SHARE_RELAY_URL=https://mev-share.flashbots.net
MEV_SHARE_SIGNING_KEY=your_mev_share_signing_key_hex

# =============================================================================
# Risk Management Configuration
# =============================================================================
# Maximum position size in USD
MAX_POSITION_SIZE=1000000

# Maximum daily loss in USD
MAX_DAILY_LOSS=100000

# Maximum drawdown percentage (0.05 = 5%)
MAX_DRAWDOWN=0.05

# Maximum leverage (1.0 = no leverage)
MAX_LEVERAGE=1.0

# Stop loss percentage (0.02 = 2%)
STOP_LOSS_PERCENTAGE=0.02

# =============================================================================
# Machine Learning Configuration
# =============================================================================
# ML Model Path (relative to project root)
ML_MODEL_PATH=ml_training/models

# ONNX Model File
ONNX_MODEL_FILE=trading_model.onnx

# Prediction confidence threshold (0.0 - 1.0)
ML_CONFIDENCE_THRESHOLD=0.6

# Feature extraction sampling rate (every N tickers)
FEATURE_SAMPLE_RATE=5

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_RECONNECT_INTERVAL_MS=1000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_RECONNECT_ATTEMPTS=10
WS_BUFFER_SIZE=1048576

# =============================================================================
# Circuit Breaker Configuration
# =============================================================================
# Enable circuit breaker for failure protection
ENABLE_CIRCUIT_BREAKER=true

# Max failures before circuit opens
CIRCUIT_BREAKER_MAX_FAILURES=10

# Circuit breaker timeout in seconds
CIRCUIT_BREAKER_TIMEOUT_SECS=60

# =============================================================================
# Production Deployment Configuration
# =============================================================================
# Environment (development/staging/production)
NODE_ENV=production

# Enable production optimizations
ENABLE_PRODUCTION_OPTIMIZATIONS=true

# CPU affinity (comma-separated core IDs)
CPU_AFFINITY=0,1,2,3

# Memory pool size in bytes (1GB = 1073741824)
MEMORY_POOL_SIZE=1073741824

# =============================================================================
# Security Configuration
# =============================================================================
# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_encryption_key_64_chars_hex

# Enable HSM (Hardware Security Module) for key management
ENABLE_HSM=false
HSM_PROVIDER=aws-kms
HSM_REGION=us-east-1

# =============================================================================
# Alerting Configuration
# =============================================================================
# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Email for alerts (optional)
ALERT_EMAIL=alerts@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# =============================================================================
# Advanced Configuration (Usually don't need to change)
# =============================================================================
# Connection pool sizes
DB_CONNECTION_POOL_SIZE=10
REDIS_CONNECTION_POOL_SIZE=10

# Request timeouts
HTTP_REQUEST_TIMEOUT_MS=30000
WS_REQUEST_TIMEOUT_MS=10000

# Rate limiting
BINANCE_RATE_LIMIT=1200
OKX_RATE_LIMIT=20

# Backtesting configuration
ENABLE_BACKTESTING=false
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31

# =============================================================================
# Development/Debug Configuration
# =============================================================================
# Enable debug mode (verbose logging)
DEBUG_MODE=false

# Enable profiling
ENABLE_PROFILING=false

# Enable memory debugging
ENABLE_MEMORY_DEBUG=false

# Dry run mode (simulate trades without executing)
DRY_RUN_MODE=false
