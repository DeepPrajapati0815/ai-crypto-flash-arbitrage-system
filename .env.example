# ============================================
# HFT Arbitrage Bot - Environment Variables
# ============================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.template .env  (or copy env.example .env for full options)
# 2. Fill in YOUR values below (replace all "CHANGE_ME" values)
# 3. Run: docker compose up -d (or use deploy.ps1/deploy.sh)
# ============================================

# ============================================
# SECURITY (REQUIRED - CHANGE THESE!)
# ============================================
POSTGRES_PASSWORD=123456
GRAFANA_ADMIN_PASSWORD=123456

# ============================================
# BASIC SETTINGS
# ============================================
RUST_LOG=info
NODE_ENV=production

# ============================================
# EXCHANGE API KEYS (Optional - for live trading)
# ============================================
# Leave empty to run in demo mode
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ============================================
# BLOCKCHAIN (Optional - for DEX trading)
# ============================================
# Get free RPC from: https://llamarpc.com or https://alchemy.com
EVM_RPC_URL=https://eth.llamarpc.com
EVM_CHAIN_ID=1
EVM_PRIVATE_KEY=
FLASH_ARB_ADDRESS=

# ============================================
# MEV (Optional - for MEV bundles)
# ============================================
USE_MEV_FIRST=false
FLASHBOTS_SIGNING_KEY=

# ============================================
# PORTS (Change if needed)
# ============================================
METRICS_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============================================
# ADVANCED (Usually don't change)
# ============================================
POSTGRES_DB=hft_bot
POSTGRES_USER=hftbot
MAX_CONCURRENT_ORDERS=100
LATENCY_TARGET_US=1000
