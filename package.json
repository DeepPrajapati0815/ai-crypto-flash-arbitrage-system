  "author": "AI Crypto Flash Arbitrage System",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.0",
    "@openzeppelin/contracts": "^4.9.0",
    "chai": "^4.3.0",
    "dotenv": "^16.3.0",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.0"
  },
  "dependencies": {
